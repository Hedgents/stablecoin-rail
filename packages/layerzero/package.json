{
  "name": "@hedgents/stablecoin-rail-layerzero",
  "version": "0.1.0",
  "description": "LayerZero Value Transfer API funding adapters for Hedgents Stablecoin Rail.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Hedgents",
  "homepage": "https://github.com/Hedgents/stablecoin-rail#readme",
  "keywords": [
    "layerzero",
    "usdt0",
    "tron",
    "solana",
    "usdt",
    "stablecoin"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hedgents/stablecoin-rail": "^0.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hedgents/stablecoin-rail.git",
    "directory": "packages/layerzero"
  },
  "bugs": {
    "url": "https://github.com/Hedgents/stablecoin-rail/issues"
  }
}
