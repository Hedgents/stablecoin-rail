# Stablecoin Rail — bridge demo environment.
# Copy to .env (local) or set in the Vercel project. Every variable is optional:
# an unset value gates its route rather than breaking the app.

# Destination chain reads (token-account checks). The public endpoint works but
# is rate-limited; set a private RPC for any real load.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Raises Mayan's rate limit for the BNB Chain route. The route works without it.
# MAYAN_API_KEY=

# Enables both LayerZero routes: TRON USDT and Robinhood Chain USDG.
# LAYERZERO_API_KEY=

# Optional hardening for the TRON route: a comma-separated list of allowed
# USDT0 contract addresses. Without it the adapter still surfaces the contract
# it will call; with it the target is pinned.
# USDT0_TRON_ALLOWLIST=

# Arm real transfers. The default is quote-only: quotes are live, but the sign
# button is disabled and nothing can be sent. Set to "enabled" only on a
# deployment you control, after you accept that transactions are irreversible.
RAIL_DEMO_SIGNING=disabled

# The project tip. Defaults to the maintainer's Solana address. Override with
# your own address per deployment, or set to an empty string to hide the tip.
DONATION_ADDRESS=qw4hzfV7UUXTrNh3hiS9Q8KSPMXWUusNoyFKLvtcMMX
DONATION_USD=10

# Local dev server port only (not used on Vercel).
PORT=8787
